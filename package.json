{
  "name": "change-days-to-ship-electron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite --config src/renderer/vite.config.js\" \"wait-on tcp:5173 && powershell -NoProfile -Command \\\"$env:ELECTRON_RENDERER_URL='http://127.0.0.1:5173'; $env:ELECTRON_REMOTE_DEBUGGING_PORT='9222'; electron .\\\"\"",
    "build": "vite build --config src/renderer/vite.config.js",
    "start": "electron ."
  },
  "dependencies": {
    "electron": "28.3.3",
    "node-fetch": "^3.3.2",
    "sql.js": "^1.13.0",
    "vue": "3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "4.6.2",
    "concurrently": "7.6.0",
    "vite": "4.5.14",
    "wait-on": "7.2.0"
  }
}
